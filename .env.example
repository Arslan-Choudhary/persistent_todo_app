# Copy to .env.local before running: cp .env.example .env.local
# Local MongoDB (default port):
MONGODB_URI=mongodb://127.0.0.1:27017/devweekends_todos

# Or MongoDB Atlas:
# MONGODB_URI=mongodb+srv://<user>:<password>@<cluster>.mongodb.net/devweekends_todos

# Public production URL for canonical/robots/sitemap generation:
# NEXT_PUBLIC_SITE_URL=https://your-domain.com
